# ProKerala API credentials (https://api.prokerala.com)
# DO NOT commit real values — copy this file to .env and fill in.
PROKERALA_CLIENT_ID=your-prokerala-client-id
PROKERALA_CLIENT_SECRET=your-prokerala-client-secret

# Mongo connection string used by mongoose
MONGO_URI=mongodb://localhost:27017/pandt

# JWT secret for auth tokens
JWT_SECRET=replace-me-with-a-long-random-string

# SMTP (nodemailer) credentials for OTP / password-reset email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
SMTP_FROM="Thanathu Madom <noreply@example.com>"

# Server port (optional, default 5000)
PORT=5000
